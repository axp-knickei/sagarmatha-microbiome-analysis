#!/bin/bash
#PBS -N blackice_nm_stab_test
#PBS -l nodes=1:ppn=2,mem=8gb,walltime=00:20:00
#PBS -j oe
#PBS -o logs/blackice_netmoss_altitude_stability_smoke_test.pbs.log

set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p logs results/netmoss_altitude_stability_smoke
source hpc/netmoss_common.sh
print_netmoss_job_context
setup_netmoss_conda

bash hpc/tests/test_netmoss_altitude_stability_pbs.sh \
  "results/netmoss_altitude_stability_smoke/${PBS_JOBID:-local}"

echo "NetMoss altitude stability smoke test completed: $(date)"
