#!/bin/bash
#PBS -N blackice_netmoss_stab
#PBS -q workq
#PBS -l nodes=1:ppn=8,mem=32gb,walltime=12:00:00
#PBS -j oe
#PBS -o logs/blackice_netmoss_altitude_stability.pbs.log

# Participant-resampled internal stability assessment for the separate
# low/initial-versus-high-altitude NetMoss scenario.
# Submit after the smoke test:
# qsub -v NETMOSS_STABILITY_ACKNOWLEDGE_EXPLORATORY=YES \
#   hpc/job_netmoss_altitude_stability.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p logs results/netmoss_altitude_stability
source hpc/netmoss_common.sh
print_netmoss_job_context
setup_netmoss_conda

if [ "${NETMOSS_STABILITY_ACKNOWLEDGE_EXPLORATORY:-NO}" != "YES" ]; then
  echo "ERROR: stability here means internal reproducibility, not external validation." >&2
  echo "Review docs/netmoss-methods.md, then resubmit with acknowledgement." >&2
  exit 2
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
worker_count="${NETMOSS_STABILITY_THREADS:-${PBS_NP:-8}}"

read -r -a rscript_cmd <<<"${NETMOSS_RSCRIPT}"
"${rscript_cmd[@]}" scripts/netmoss/validate_environment.R --require-netmoss
"${rscript_cmd[@]}" scripts/netmoss/run_altitude_stability.R \
  --config config/netmoss_altitude_stability.yml \
  --threads "${worker_count}" \
  --acknowledge-exploratory \
  --force
"${rscript_cmd[@]}" scripts/netmoss/summarize_altitude_stability.R \
  --config config/netmoss_altitude_stability.yml \
  --force

echo "NetMoss altitude stability job completed: $(date)"
