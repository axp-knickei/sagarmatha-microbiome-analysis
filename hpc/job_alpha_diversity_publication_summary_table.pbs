#!/bin/bash
#PBS -N blackice_alpha_summary_table
#PBS -l nodes=1:ppn=4
#PBS -l mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o logs/blackice_alpha_summary_table.pbs.log

# OpenPBS wrapper for the publication-ready alpha-diversity summary table.
# Submit from the repository root:
#   qsub hpc/job_alpha_diversity_publication_summary_table.pbs
#
# Useful overrides:
#   qsub -v CONDA_MODULE_NAME=intelpython/2022.2.0,CONDA_ENV_NAME=glmm-hpc hpc/job_alpha_diversity_publication_summary_table.pbs
#   qsub -v BLACKICE_ALPHA_OUTPUT_DIR=results/alpha_diversity hpc/job_alpha_diversity_publication_summary_table.pbs
#   qsub -v BLACKICE_ALPHA_SUMMARY_INPUT=results/alpha_diversity/tables/alpha_diversity_with_metadata.csv hpc/job_alpha_diversity_publication_summary_table.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:-$PWD}"

mkdir -p logs results/alpha_diversity/logs results/alpha_diversity/tables docs/reports

RUN_LABEL="${PBS_JOBNAME:-blackice_alpha_summary_table}.${PBS_JOBID:-local}"
exec > >(tee -a "logs/${RUN_LABEL}.out") 2> >(tee -a "logs/${RUN_LABEL}.err" >&2)

echo "=== BlackICE alpha-diversity publication summary table job started: $(date) ==="
echo "Host: $(hostname)"
echo "Working directory: $(pwd)"
echo "PBS job id: ${PBS_JOBID:-local}"
echo "Git commit: $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export VECLIB_MAXIMUM_THREADS="${VECLIB_MAXIMUM_THREADS:-1}"

CONDA_MODULE="${CONDA_MODULE_NAME:-intelpython/2022.2.0}"

if command -v module >/dev/null 2>&1; then
  module purge || true
  if [ -n "$CONDA_MODULE" ]; then
    module load "$CONDA_MODULE"
  fi
fi

if ! command -v conda >/dev/null 2>&1; then
  for conda_profile in \
    "$HOME/miniconda3/etc/profile.d/conda.sh" \
    "$HOME/anaconda3/etc/profile.d/conda.sh" \
    "$HOME/mambaforge/etc/profile.d/conda.sh" \
    "$HOME/miniforge3/etc/profile.d/conda.sh"
  do
    if [ -f "$conda_profile" ]; then
      # shellcheck disable=SC1090
      source "$conda_profile"
      break
    fi
  done
fi

CONDA_ENV="${CONDA_ENV_NAME:-glmm-hpc}"
if command -v conda >/dev/null 2>&1; then
  R_CMD=(conda run --no-capture-output -n "$CONDA_ENV" R)
  RSCRIPT_CMD=(conda run --no-capture-output -n "$CONDA_ENV" Rscript)
else
  echo "ERROR: conda command was not found. Set CONDA_MODULE_NAME or install/create the Conda environment first." >&2
  exit 1
fi

export BLACKICE_ALPHA_OUTPUT_DIR="${BLACKICE_ALPHA_OUTPUT_DIR:-results/alpha_diversity}"
export BLACKICE_ALPHA_SUMMARY_INPUT="${BLACKICE_ALPHA_SUMMARY_INPUT:-$BLACKICE_ALPHA_OUTPUT_DIR/tables/alpha_diversity_with_metadata.csv}"
export BLACKICE_METADATA_PATH="${BLACKICE_METADATA_PATH:-data/raw/sample_info.csv}"

echo "R version: $("${R_CMD[@]}" --version | head -1)"
echo "Conda environment: $CONDA_ENV"
echo "Alpha-diversity output directory: $BLACKICE_ALPHA_OUTPUT_DIR"
echo "Alpha-diversity summary input: $BLACKICE_ALPHA_SUMMARY_INPUT"
echo "Metadata fallback path: $BLACKICE_METADATA_PATH"

"${RSCRIPT_CMD[@]}" scripts/alpha_diversity/08_create_alpha_diversity_publication_summary_table.R

echo "=== BlackICE alpha-diversity publication summary table job finished: $(date) ==="
