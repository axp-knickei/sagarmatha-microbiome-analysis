#!/bin/bash
#PBS -N blackice_netmoss_pairs_test
#PBS -l nodes=1:ppn=4,mem=8gb,walltime=01:00:00
#PBS -j oe
#PBS -o logs/blackice_netmoss_matched_timepoint_smoke_test.pbs.log

# Scheduler smoke test for the matched-timepoint companion workflow.
# Uses repository test data only; no biological conclusions are produced.
# qsub hpc/job_netmoss_matched_timepoint_smoke_test.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p logs
source hpc/netmoss_common.sh
print_netmoss_job_context
setup_netmoss_conda

bash hpc/tests/test_netmoss_matched_timepoint_pbs.sh \
  "results/netmoss_matched_timepoint_smoke/${PBS_JOBID:-local}"

echo "Matched-timepoint companion smoke test completed: $(date)"
