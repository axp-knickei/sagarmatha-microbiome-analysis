#!/bin/bash
#PBS -N blackice_alpha_window_lmm
#PBS -l nodes=1:ppn=4
#PBS -l mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o logs/blackice_alpha_window_lmm.pbs.log

# OpenPBS wrapper for alpha-diversity LMMs across predefined W1-W6 biological
# windows and all paired W1-vs-W2 through W5-vs-W6 window plots.
#
# Submit from the repository root:
#   qsub hpc/job_alpha_diversity_window_lmm.pbs
#
# Useful overrides:
#   qsub -v CONDA_MODULE_NAME=intelpython/2022.2.0,CONDA_ENV_NAME=glmm-hpc hpc/job_alpha_diversity_window_lmm.pbs
#   qsub -v BLACKICE_ALPHA_METADATA_PATH=results/alpha_diversity/tables/alpha_diversity_with_metadata.csv hpc/job_alpha_diversity_window_lmm.pbs
#   qsub -v BLACKICE_WINDOW_DEFINITION_PATH=results/metadata_expedition_windows/proposed_biological_windows.csv hpc/job_alpha_diversity_window_lmm.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:-$PWD}"

mkdir -p logs results/alpha_diversity_window_lmm/logs results/alpha_diversity_window_lmm/tables results/alpha_diversity_window_lmm/figures

RUN_LABEL="${PBS_JOBNAME:-blackice_alpha_window_lmm}.${PBS_JOBID:-local}"
exec > >(tee -a "logs/${RUN_LABEL}.out") 2> >(tee -a "logs/${RUN_LABEL}.err" >&2)

echo "=== BlackICE alpha-diversity window LMM job started: $(date) ==="
echo "Host: $(hostname)"
echo "Working directory: $(pwd)"
echo "PBS job id: ${PBS_JOBID:-local}"
echo "Git commit: $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export VECLIB_MAXIMUM_THREADS="${VECLIB_MAXIMUM_THREADS:-1}"

CONDA_MODULE="${CONDA_MODULE_NAME:-intelpython/2022.2.0}"

if command -v module >/dev/null 2>&1; then
  module purge || true
  if [ -n "$CONDA_MODULE" ]; then
    module load "$CONDA_MODULE"
  fi
fi

if ! command -v conda >/dev/null 2>&1; then
  for conda_profile in \
    "$HOME/miniconda3/etc/profile.d/conda.sh" \
    "$HOME/anaconda3/etc/profile.d/conda.sh" \
    "$HOME/mambaforge/etc/profile.d/conda.sh" \
    "$HOME/miniforge3/etc/profile.d/conda.sh"
  do
    if [ -f "$conda_profile" ]; then
      # shellcheck disable=SC1090
      source "$conda_profile"
      break
    fi
  done
fi

CONDA_ENV="${CONDA_ENV_NAME:-glmm-hpc}"
if command -v conda >/dev/null 2>&1; then
  R_CMD=(conda run --no-capture-output -n "$CONDA_ENV" R)
  RSCRIPT_CMD=(conda run --no-capture-output -n "$CONDA_ENV" Rscript)
else
  echo "ERROR: conda command was not found. Set CONDA_MODULE_NAME or install/create the Conda environment first." >&2
  exit 1
fi

export BLACKICE_ALPHA_METADATA_PATH="${BLACKICE_ALPHA_METADATA_PATH:-results/alpha_diversity/tables/alpha_diversity_with_metadata.csv}"
export BLACKICE_WINDOW_DEFINITION_PATH="${BLACKICE_WINDOW_DEFINITION_PATH:-results/metadata_expedition_windows/proposed_biological_windows.csv}"
export BLACKICE_ALPHA_WINDOW_LMM_OUTPUT_DIR="${BLACKICE_ALPHA_WINDOW_LMM_OUTPUT_DIR:-results/alpha_diversity_window_lmm}"

echo "R version: $("${R_CMD[@]}" --version | head -1)"
echo "Conda environment: $CONDA_ENV"
echo "Alpha-diversity metadata table: $BLACKICE_ALPHA_METADATA_PATH"
echo "Window definitions: $BLACKICE_WINDOW_DEFINITION_PATH"
echo "Output directory: $BLACKICE_ALPHA_WINDOW_LMM_OUTPUT_DIR"

"${RSCRIPT_CMD[@]}" scripts/alpha_diversity_window_lmm/fit_plot_alpha_window_lmm.R

echo "=== BlackICE alpha-diversity window LMM job finished: $(date) ==="
