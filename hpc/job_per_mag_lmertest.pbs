#!/bin/bash
#PBS -N blackice_per_mag_lmm
#PBS -l nodes=1:ppn=4
#PBS -l mem=16gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o blackice_per_mag_lmm.pbs.log

# OpenPBS wrapper for the current per-MAG lmerTest workflow.
# Submit from the repository root:
#   qsub hpc/job_per_mag_lmertest.pbs
#
# Useful overrides:
#   qsub -v RUN_MODE=dryrun hpc/job_per_mag_lmertest.pbs
#   qsub -v CONDA_MODULE_NAME=intelpython/2022.2.0,CONDA_ENV_NAME=glmm-hpc hpc/job_per_mag_lmertest.pbs
#   qsub -J 1-10 -v CHUNK_COUNT=10 hpc/job_per_mag_lmertest.pbs
#   qsub -v RUN_STAGE=postprocess hpc/job_per_mag_lmertest.pbs

set -euo pipefail

cd "${PBS_O_WORKDIR:-$PWD}"

mkdir -p logs results/hpc_per_mag_lmertest tmp

RUN_LABEL="${PBS_JOBNAME:-blackice_per_mag_lmm}.${PBS_JOBID:-local}"
exec > >(tee -a "logs/${RUN_LABEL}.out") 2> >(tee -a "logs/${RUN_LABEL}.err" >&2)

echo "=== BlackICE per-MAG LMM job started: $(date) ==="
echo "Host: $(hostname)"
echo "Working directory: $(pwd)"
echo "PBS job id: ${PBS_JOBID:-local}"
echo "PBS array index: ${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-none}}"
echo "Git commit: $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export VECLIB_MAXIMUM_THREADS="${VECLIB_MAXIMUM_THREADS:-1}"

CONDA_MODULE="${CONDA_MODULE_NAME:-intelpython/2022.2.0}"

if command -v module >/dev/null 2>&1; then
  module purge || true
  if [ -n "$CONDA_MODULE" ]; then
    module load "$CONDA_MODULE"
  fi
fi

if ! command -v conda >/dev/null 2>&1; then
  for conda_profile in \
    "$HOME/miniconda3/etc/profile.d/conda.sh" \
    "$HOME/anaconda3/etc/profile.d/conda.sh" \
    "$HOME/mambaforge/etc/profile.d/conda.sh" \
    "$HOME/miniforge3/etc/profile.d/conda.sh"
  do
    if [ -f "$conda_profile" ]; then
      # shellcheck disable=SC1090
      source "$conda_profile"
      break
    fi
  done
fi

CONDA_ENV="${CONDA_ENV_NAME:-glmm-hpc}"
if command -v conda >/dev/null 2>&1; then
  R_CMD=(conda run --no-capture-output -n "$CONDA_ENV" R)
  RSCRIPT_CMD=(conda run --no-capture-output -n "$CONDA_ENV" Rscript)
else
  echo "ERROR: conda command was not found. Set CONDA_MODULE_NAME or install/create the Conda environment first." >&2
  exit 1
fi

RUN_MODE="${RUN_MODE:-full}"
RUN_STAGE="${RUN_STAGE:-auto}"
INPUT_PATH="${BLACKICE_INPUT:-data/processed/cleaned_data.rds}"
OUTPUT_DIR="${BLACKICE_OUTPUT_DIR:-results/hpc_per_mag_lmertest}"
ROOT_RESULTS_CSV="${OUTPUT_DIR}/tables/per_mag_lmertest_hpc_results.csv"
COMBINED_RESULTS_CSV="${OUTPUT_DIR}/tables/per_mag_lmertest_hpc_results_combined.csv"
PLOT_ORCHESTRATOR="scripts/hpc_plot_per_mag_lmertest_results.R"

if [ ! -f "$PLOT_ORCHESTRATOR" ]; then
  echo "ERROR: plotting orchestrator was not found: $PLOT_ORCHESTRATOR" >&2
  exit 1
fi

args=(
  scripts/hpc_run_per_mag_lmertest.R
  --input "$INPUT_PATH"
  --output-dir "$OUTPUT_DIR"
)

if [ "$RUN_MODE" = "dryrun" ]; then
  args+=(--max-mags "${MAX_MAGS:-10}")
elif [ "$RUN_MODE" != "full" ]; then
  echo "ERROR: RUN_MODE must be 'dryrun' or 'full'." >&2
  exit 1
fi

if [ -n "${CHUNK_COUNT:-}" ] && [ "$CHUNK_COUNT" -gt 1 ]; then
  array_index="${CHUNK_INDEX:-${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}}"
  if [ -z "$array_index" ]; then
    echo "ERROR: CHUNK_COUNT is set but no CHUNK_INDEX or PBS array index was found." >&2
    exit 1
  fi
  args+=(--chunk-count "$CHUNK_COUNT" --chunk-index "$array_index")
fi

echo "R version: $("${R_CMD[@]}" --version | head -1)"
echo "Conda environment: $CONDA_ENV"
echo "Run mode: $RUN_MODE"
echo "Run stage: $RUN_STAGE"
echo "Input: $INPUT_PATH"
echo "Output: $OUTPUT_DIR"
echo "Command: Rscript ${args[*]}"

if [ "$RUN_STAGE" = "postprocess" ]; then
  echo "Skipping analysis; running combine-and-plot postprocess stage."
else
  "${RSCRIPT_CMD[@]}" "${args[@]}"
fi

plot_stage="skip"
case "$RUN_STAGE" in
  auto)
    if [ "$RUN_MODE" = "dryrun" ]; then
      plot_stage="skip"
    elif [ "${CHUNK_COUNT:-1}" -gt 1 ]; then
      plot_stage="skip"
    else
      plot_stage="full"
    fi
    ;;
  analysis)
    plot_stage="skip"
    ;;
  full)
    if [ "$RUN_MODE" = "dryrun" ]; then
      echo "Dry-run mode requested; skipping final plotting stage."
      plot_stage="skip"
    elif [ "${CHUNK_COUNT:-1}" -gt 1 ]; then
      echo "Chunked execution requested; skipping plotting until a postprocess job runs."
      plot_stage="skip"
    else
      plot_stage="full"
    fi
    ;;
  postprocess)
    plot_stage="postprocess"
    ;;
  *)
    echo "ERROR: RUN_STAGE must be one of auto, analysis, full, or postprocess." >&2
    exit 1
    ;;
esac

if [ "$plot_stage" = "full" ]; then
  "${RSCRIPT_CMD[@]}" "$PLOT_ORCHESTRATOR" \
    --input-dir "$OUTPUT_DIR" \
    --output-dir "$OUTPUT_DIR" \
    --results-csv "$ROOT_RESULTS_CSV" \
    --no-root-metadata
elif [ "$plot_stage" = "postprocess" ]; then
  "${RSCRIPT_CMD[@]}" "$PLOT_ORCHESTRATOR" \
    --input-dir "$OUTPUT_DIR" \
    --output-dir "$OUTPUT_DIR" \
    --results-csv "$COMBINED_RESULTS_CSV"
fi

echo "=== BlackICE per-MAG LMM job finished: $(date) ==="
