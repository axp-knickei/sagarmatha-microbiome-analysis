#!/bin/bash
#PBS -N blackice_funcdyn
#PBS -l nodes=1:ppn=4,mem=64gb,walltime=24:00:00
#PBS -j oe
#PBS -o blackice_functional_community_dynamics.pbs.log

# OpenPBS wrapper for functional community restructuring and recovery analysis.
# Submit from the repository root. Production inputs may be overridden without
# storing private Nebula paths in Git:
#   qsub -v FUNCDYN_ABUNDANCE_FILE=/path/gut.csv,FUNCDYN_METADATA_FILE=/path/sample_info.csv hpc/job_functional_community_dynamics.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"
mkdir -p logs
RUN_LABEL="${PBS_JOBNAME:-blackice_funcdyn}.${PBS_JOBID:-local}"
exec > >(tee -a "logs/${RUN_LABEL}.out") 2> >(tee -a "logs/${RUN_LABEL}.err" >&2)

echo "=== BlackICE functional community dynamics started: $(date) ==="
echo "Host: $(hostname)"
echo "Working directory: $(pwd)"
echo "PBS job id: ${PBS_JOBID:-local}"
echo "Git commit: $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
CONDA_MODULE="${CONDA_MODULE_NAME:-intelpython/2022.2.0}"
if command -v module >/dev/null 2>&1; then
  module purge || true
  [[ -z "$CONDA_MODULE" ]] || module load "$CONDA_MODULE"
fi
if ! command -v conda >/dev/null 2>&1; then
  for conda_profile in "$HOME/miniconda3/etc/profile.d/conda.sh" "$HOME/anaconda3/etc/profile.d/conda.sh" "$HOME/mambaforge/etc/profile.d/conda.sh" "$HOME/miniforge3/etc/profile.d/conda.sh"; do
    if [[ -f "$conda_profile" ]]; then source "$conda_profile"; break; fi
  done
fi
command -v conda >/dev/null 2>&1 || { echo "ERROR: conda was not found." >&2; exit 1; }

CONDA_ENV="${CONDA_ENV_NAME:-glmm-hpc}"
CONFIG="${FUNCDYN_CONFIG:-config/functional_community_dynamics.yml}"
FROM_STAGE="${FUNCDYN_FROM_STAGE:-0}"
TO_STAGE="${FUNCDYN_TO_STAGE:-4}"
FORCE="${FUNCDYN_FORCE:-0}"
CONDA_RUN=(conda run --no-capture-output -n "$CONDA_ENV")

echo "Configuration: $CONFIG"
echo "Stages: $FROM_STAGE through $TO_STAGE"
echo "Sample contract: identical T1-T10 subset; Ta/Tb excluded"
echo "Primary functional layer/distance: KO/Hellinger"
echo "Interpretation: predicted genomic potential, not expression or activity"
"${CONDA_RUN[@]}" Rscript scripts/validate_functional_community_dynamics_environment.R
RUN_ARGS=(--config "$CONFIG" --from-stage "$FROM_STAGE" --to-stage "$TO_STAGE")
case "$FORCE" in
  1|true|TRUE|yes|YES) RUN_ARGS+=(--force) ;;
  0|false|FALSE|no|NO) ;;
  *) echo "ERROR: FUNCDYN_FORCE must be 0/1, true/false, or yes/no." >&2; exit 2 ;;
esac
"${CONDA_RUN[@]}" bash scripts/run_functional_community_dynamics.sh "${RUN_ARGS[@]}"
echo "=== BlackICE functional community dynamics finished: $(date) ==="
